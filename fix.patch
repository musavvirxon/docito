+function parseSlotStart(slot_start: string): { date: string; time: string } {
+  // If slot_start includes timezone offset or Z, use Date for correctness.
+  const hasTz = /[zZ]|[+-]\d{2}:?\d{2}$/.test(slot_start);
+  if (hasTz) {
+    const d = new Date(slot_start);
+    if (Number.isNaN(d.getTime())) throw new Error("Invalid slot_start");
+    const iso = d.toISOString();
+    return { date: iso.slice(0, 10), time: iso.slice(11, 19) };
+  }
