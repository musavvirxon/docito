+  const timePart = timePartRaw.trim();
+  // accept HH:MM, HH:MM:SS
+  const norm = timePart.length === 5 ? `${timePart}:00` : timePart.slice(0, 8);
+  if (!/^\d{2}:\d{2}:\d{2}$/.test(norm)) throw new Error("Invalid slot_start time");
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(datePart)) throw new Error("Invalid slot_start date");
+  return { date: datePart, time: norm };
