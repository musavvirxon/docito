 # All hashed assets (immutable - content hash changes on update)
 /assets/*
   Cache-Control: public, max-age=31536000, immutable
 
 # Logo images
 /logos/*
   Cache-Control: public, max-age=31536000, immutable
 
 /logos/horizontal/*
   Cache-Control: public, max-age=31536000, immutable
 
 /logos/vertical/*
   Cache-Control: public, max-age=31536000, immutable
 
 # Root images
 /*.png
   Cache-Control: public, max-age=31536000, immutable
 
 /*.webp
   Cache-Control: public, max-age=31536000, immutable
 
 /*.jpg
   Cache-Control: public, max-age=31536000, immutable
 
 /*.svg
   Cache-Control: public, max-age=31536000, immutable
 
 /*.ico
   Cache-Control: public, max-age=31536000, immutable
 
 # Locales
 /locales/*
   Cache-Control: public, max-age=31536000, immutable
 
 # Don't cache HTML
 /
   Cache-Control: no-cache
 
 /index.html
   Cache-Control: no-cache
